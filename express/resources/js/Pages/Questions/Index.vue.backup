const parts = props.parts;

const sortedQuestionnaires = computed(() => {
    return [...parts].sort((a, b) => a.name.localeCompare(b.name));
});
const showDeleteQuestion = ref(false);
const questionToDeleteIdx = ref(null);
const deleteQuestion = () => {
    if (questionToDeleteIdx.value === null) return;
    const question = props.questions[questionToDeleteIdx.value];
    if (!question?.id) return;

    form.delete(route('questions.destroy', [
        props.questionnaire.code,
        question.id
    ]), {
        preserveScroll: true,
        onSuccess: () => {
            toast.success(`Question deleted`, { timeout: 2000 });
            showDeleteQuestion.value = false;
            questionToDeleteIdx.value = null;
        },
        onError: () => {
            // handle error
        },
        onFinish: () => {
            showDeleteQuestion.value = false;
            questionToDeleteIdx.value = null;
        }
    });
};

const handleQuestionMoved = async (event) => {
    const { questionnaireCode, oldOrder, newOrder } = event.detail;
    
    // Only refresh if this is the same questionnaire
    if (questionnaireCode === props.questionnaire.code) {
        console.log(`Question moved from order ${oldOrder} to ${newOrder}, refreshing questions data...`);
        
        // Wait a bit for the backend to process the move
        setTimeout(async () => {
            try {
                const response = await fetch(route('questions.index', [props.questionnaire.code]), {
                    method: 'GET',
                    headers: {
                        'Accept': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });
                
                if (response.ok) {
                    const data = await response.json();
                    if (data.success && data.data) {
                        // Update the questions data
                        // Note: In a real implementation, you might want to use a state management solution
                        // or emit an event to the parent component to update the data
                        console.log('Questions data refreshed after move');
                    }
                }
            } catch (error) {
                console.error('Failed to refresh questions data:', error);
            }
        }, 500);
    }
};

